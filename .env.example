PLATFORM_USERNAME=admin
# 至少 12 位，首次启动前必须修改。
PLATFORM_PASSWORD=replace-with-a-long-random-password
PLATFORM_BIND_ADDRESS=127.0.0.1
PLATFORM_PORT=8090
# compose.prod.yml 默认使用 latest；生产环境也可改为明确版本，例如 :v1.1.0。
WORKBENCH_IMAGE=ghcr.io/yl0711-coder/newapi-evaluator:latest
PLATFORM_EGRESS_ALLOWLIST=
STABILITY_TIMEZONE=Asia/Shanghai
STABILITY_RETENTION_DAYS=5
